{
	"moduleFileExtensions": ["js", "json", "ts"],
	"moduleDirectories": ["node_modules", "src"],
	"moduleNameMapper": {
		"^@template/configs-envs/(.*)$": "<rootDir>/../../libs/configs/envs/src/$1",
		"^@template/utils/(.*)$": "<rootDir>/../../libs/utils/src/$1",
		"^@template/dto/(.*)$": "<rootDir>/../../libs/dto/src/$1",
		"^@template/interfaces/(.*)$": "<rootDir>/../../libs/interfaces/src/$1",
		"^@template/api-redis/(.*)$": "<rootDir>/../../libs/api/redis/src/$1",
		"^@template/kafka/(.*)$": "<rootDir>/../../libs/kafka/src/$1",
		"^#src/(.*)$": "<rootDir>/src/$1",
		"^#mocks/(.*)$": "<rootDir>/src/utils/tests/mocks/$1",
		"src/(.*)": "<rootDir>/src/$1"
	},
	"rootDir": "./",
	"modulePaths": ["<rootDir>"],
	"testRegex": ".*\\.spec\\.ts$",
	"transform": {
		"^.+\\.(t|j)s$": "ts-jest"
	},
	"collectCoverageFrom": ["src/**/*.(t|j)s"],
	"coveragePathIgnorePatterns": [
		".module.ts",
		".mocks.ts",
		"main.ts",
		"src/config",
		"src/database"
	],
	"coverageDirectory": "./coverage",
	"testEnvironment": "node"
}
