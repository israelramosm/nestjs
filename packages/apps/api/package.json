{
	"name": "@template/api",
	"version": "0.0.1",
	"description": "NestJS API app (template)",
	"private": true,
	"type": "module",
	"exports": {
		"./*": {
			"types": "./src/*.ts",
			"default": "./src/*.ts"
		},
		"./package.json": "./package.json"
	},
	"imports": {
		"#src/*": {
			"types": "./src/*.ts",
			"default": "./src/*.ts"
		}
	},
	"scripts": {
		"start": "nest start",
		"start:dev": "nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/main",
		"dev": "bun --watch src/main.ts",
		"build": "nest build",
		"clean": "rm -rf dist *.tsbuildinfo",
		"typecheck": "tsc --noEmit",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage",
		"test:e2e": "jest --config ./e2e/jest-e2e.json",
		"typeorm:cli": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli -d src/config/typeorm.config.ts",
		"migration:generate": "bun run typeorm:cli migration:generate",
		"migration:create": "bun run typeorm:cli migration:create",
		"migration:run": "bun run typeorm:cli migration:run",
		"migration:revert": "bun run typeorm:cli migration:revert"
	},
	"dependencies": {
		"@nestjs/common": "catalog:",
		"@nestjs/config": "catalog:",
		"@nestjs/core": "catalog:",
		"@nestjs/jwt": "catalog:",
		"@nestjs/mapped-types": "catalog:",
		"@nestjs/passport": "catalog:",
		"@nestjs/platform-express": "catalog:",
		"@nestjs/typeorm": "catalog:",
		"@template/configs-envs": "workspace:*",
		"@template/dto": "workspace:*",
		"@template/interfaces": "workspace:*",
		"@template/api-redis": "workspace:*",
		"@template/kafka": "workspace:*",
		"@template/utils": "workspace:*",
		"bcrypt": "catalog:",
		"class-transformer": "catalog:",
		"class-validator": "catalog:",
		"dotenv": "catalog:",
		"mysql2": "catalog:",
		"passport": "catalog:",
		"passport-jwt": "catalog:",
		"passport-local": "catalog:",
		"pg": "catalog:",
		"reflect-metadata": "catalog:",
		"rxjs": "catalog:",
		"typeorm": "catalog:",
		"uuid": "catalog:"
	},
	"devDependencies": {
		"@nestjs/cli": "^10.3.2",
		"@nestjs/schematics": "^10.1.1",
		"@nestjs/testing": "catalog:",
		"@types/express": "^4.17.21",
		"@types/jest": "catalog:",
		"@types/node": "catalog:",
		"@types/passport-jwt": "catalog:",
		"@types/passport-local": "catalog:",
		"@types/pg": "catalog:",
		"@types/supertest": "catalog:",
		"@types/uuid": "catalog:",
		"jest": "catalog:",
		"source-map-support": "^0.5.21",
		"supertest": "catalog:",
		"ts-jest": "catalog:",
		"ts-loader": "^9.5.1",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "catalog:"
	}
}
