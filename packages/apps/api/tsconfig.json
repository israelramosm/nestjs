{
	"extends": "../../../tsconfig.base.json",
	"compilerOptions": {
		"baseUrl": ".",
		"esModuleInterop": false,
		"module": "preserve",
		"moduleResolution": "bundler",
		"noImplicitAny": false,
		"paths": {
			"src/*": ["src/*"]
		},
		"strict": false,
		"strictNullChecks": false
	},
	"include": ["src", "e2e"],
	"exclude": ["node_modules"]
}
