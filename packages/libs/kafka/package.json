{
	"name": "@template/kafka",
	"version": "0.0.1",
	"description": "Modulo NestJS de Kafka (microservicios) configurado desde envs",
	"private": true,
	"type": "module",
	"exports": {
		"./*": "./src/*.ts"
	},
	"imports": {
		"#src/*": "./src/*"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"clean": "rm -rf dist *.tsbuildinfo",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@nestjs/common": "catalog:",
		"@nestjs/config": "catalog:",
		"@nestjs/microservices": "catalog:",
		"@template/configs-envs": "workspace:*",
		"kafkajs": "catalog:",
		"rxjs": "catalog:"
	}
}
