{
	"name": "@template/utils",
	"version": "0.0.1",
	"description": "Tipos genericos y helpers de mocks para tests",
	"private": true,
	"type": "module",
	"exports": {
		"./*": {
			"types": "./src/*.ts",
			"default": "./src/*.ts"
		},
		"./package.json": "./package.json"
	},
	"imports": {
		"#src/*": {
			"types": "./src/*.ts",
			"default": "./src/*.ts"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"clean": "rm -rf dist *.tsbuildinfo",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@types/bun": "catalog:"
	}
}
