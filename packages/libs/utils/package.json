{
	"name": "@template/utils",
	"version": "0.0.1",
	"description": "Tipos genericos y helpers de mocks para tests",
	"private": true,
	"type": "module",
	"exports": {
		"./*": "./src/*.ts"
	},
	"imports": {
		"#src/*": "./src/*"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"clean": "rm -rf dist *.tsbuildinfo",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@types/jest": "catalog:"
	}
}
