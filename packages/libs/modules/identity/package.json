{
	"name": "@template/modules-identity",
	"version": "0.0.1",
	"description": "Modulos NestJS de identidad: auth, users, profiles y passwords",
	"private": true,
	"type": "module",
	"exports": {
		"./*": {
			"types": "./src/*.ts",
			"default": "./src/*.ts"
		},
		"./package.json": "./package.json"
	},
	"imports": {
		"#src/*": {
			"types": "./src/*.ts",
			"default": "./src/*.ts"
		}
	},
	"scripts": {
		"clean": "rm -rf dist *.tsbuildinfo",
		"typecheck": "tsc --noEmit",
		"test": "bun test src"
	},
	"dependencies": {
		"@nestjs/common": "catalog:",
		"@nestjs/config": "catalog:",
		"@nestjs/core": "catalog:",
		"@nestjs/jwt": "catalog:",
		"@nestjs/mapped-types": "catalog:",
		"@nestjs/passport": "catalog:",
		"@nestjs/typeorm": "catalog:",
		"@template/configs-envs": "workspace:*",
		"bcrypt": "catalog:",
		"class-validator": "catalog:",
		"express": "^5.0.0",
		"passport": "catalog:",
		"passport-jwt": "catalog:",
		"passport-local": "catalog:",
		"typeorm": "catalog:"
	},
	"devDependencies": {
		"@nestjs/testing": "catalog:",
		"@template/shared": "workspace:*",
		"@types/bun": "catalog:",
		"@types/express": "^5.0.0",
		"@types/node": "catalog:",
		"@types/passport-jwt": "catalog:",
		"@types/passport-local": "catalog:",
		"typescript": "catalog:",
		"uuid": "catalog:"
	}
}
