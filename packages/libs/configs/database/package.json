{
	"name": "@template/configs-database",
	"version": "0.0.1",
	"description": "Configuracion de datasources TypeORM, modulo de base de datos y migraciones",
	"private": true,
	"type": "module",
	"exports": {
		"./*": {
			"types": "./src/*.ts",
			"default": "./src/*.ts"
		},
		"./package.json": "./package.json"
	},
	"imports": {
		"#src/*": {
			"types": "./src/*.ts",
			"default": "./src/*.ts"
		}
	},
	"scripts": {
		"clean": "rm -rf dist *.tsbuildinfo",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@nestjs/common": "catalog:",
		"@nestjs/config": "catalog:",
		"@nestjs/typeorm": "catalog:",
		"@template/configs-envs": "workspace:*",
		"typeorm": "catalog:"
	},
	"devDependencies": {
		"@types/node": "catalog:"
	}
}
