{
	"name": "@template/monorepo",
	"version": "0.0.1",
	"private": true,
	"description": "NestJS monorepo template (Bun workspaces + Biome + mise)",
	"license": "UNLICENSED",
	"type": "module",
	"workspaces": {
		"packages": [
			"packages/*/**"
		],
		"catalog": {
			"typescript": "^7.0.2",
			"@types/node": "^26.6.3",
			"reflect-metadata": "^0.2.2",
			"rxjs": "^7.8.1",
			"@nestjs/common": "^12.1.0",
			"@nestjs/core": "^12.1.0",
			"@nestjs/config": "^12.0.1",
			"@nestjs/platform-express": "^12.1.0",
			"@nestjs/mapped-types": "^12.0.0",
			"@nestjs/typeorm": "^12.0.1",
			"@nestjs/testing": "^12.1.0",
			"@nestjs/jwt": "^12.0.2",
			"@nestjs/passport": "^12.0.0",
			"@nestjs/microservices": "^12.1.0",
			"class-transformer": "^0.5.1",
			"class-validator": "^0.14.1",
			"dotenv": "^18.0.4",
			"joi": "^18.2.9",
			"typeorm": "^1.1.1",
			"pg": "^8.11.5",
			"mysql2": "^3.24.4",
			"ioredis": "^6.0.0",
			"kafkajs": "^2.2.4",
			"passport": "^0.7.0",
			"passport-jwt": "^4.0.1",
			"passport-local": "^1.0.0",
			"bcrypt": "^6.0.0",
			"uuid": "^14.0.2",
			"@types/bcrypt": "^5.0.2",
			"@types/bun": "^1.4.2",
			"@types/pg": "^8.11.6",
			"@types/passport-jwt": "^4.0.1",
			"@types/passport-local": "^1.0.38",
			"supertest": "^7.3.0",
			"@types/supertest": "^7.2.1"
		}
	},
	"overrides": {
		"qs": "^6.16.0",
		"multer": "^2.4.0",
		"brace-expansion": "^2.1.7"
	},
	"scripts": {
		"biome:check": "biome check .",
		"biome:fix": "biome check --write .",
		"biome:format": "biome format --write .",
		"biome:lint": "biome lint .",
		"dev:all": "bun run --filter './packages/apps/*/**' --parallel dev",
		"typecheck": "bun run --filter '*' typecheck",
		"test": "bun run --filter '*' test",
		"docker:up": "docker compose up -d",
		"docker:down": "docker compose down",
		"watch:libs": "bun run --filter './packages/libs/**' --parallel dev"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"typescript": "catalog:"
	}
}
