{
	"name": "@template/monorepo",
	"version": "0.0.1",
	"private": true,
	"description": "NestJS monorepo template (Bun workspaces + Biome + mise)",
	"license": "UNLICENSED",
	"type": "module",
	"workspaces": {
		"packages": ["packages/*/**"],
		"catalog": {
			"typescript": "^5.4.5",
			"@types/node": "^20.12.12",
			"reflect-metadata": "^0.2.2",
			"rxjs": "^7.8.1",
			"@nestjs/common": "^10.3.9",
			"@nestjs/core": "^10.3.9",
			"@nestjs/config": "^3.2.2",
			"@nestjs/platform-express": "^10.3.9",
			"@nestjs/mapped-types": "^2.0.5",
			"@nestjs/typeorm": "^10.0.2",
			"@nestjs/testing": "^10.3.9",
			"@nestjs/jwt": "^10.2.0",
			"@nestjs/passport": "^10.0.3",
			"@nestjs/microservices": "^10.3.9",
			"class-transformer": "^0.5.1",
			"class-validator": "^0.14.1",
			"dotenv": "^16.4.5",
			"joi": "^17.13.1",
			"typeorm": "^0.3.20",
			"pg": "^8.11.5",
			"mysql2": "^3.9.7",
			"ioredis": "^5.4.1",
			"kafkajs": "^2.2.4",
			"passport": "^0.7.0",
			"passport-jwt": "^4.0.1",
			"passport-local": "^1.0.0",
			"bcrypt": "^5.1.1",
			"uuid": "^10.0.0",
			"@types/bun": "^1.2.23",
			"@types/uuid": "^10.0.0",
			"@types/pg": "^8.11.6",
			"@types/passport-jwt": "^4.0.1",
			"@types/passport-local": "^1.0.38",
			"supertest": "^6.3.4",
			"@types/supertest": "^6.0.2"
		}
	},
	"scripts": {
		"biome:check": "biome check .",
		"biome:fix": "biome check --write .",
		"biome:format": "biome format --write .",
		"biome:lint": "biome lint .",
		"all:apps": "bun run --filter './packages/apps/*/**'",
		"all:libs": "bun run --filter './packages/libs/*/**'",
		"filter": "bun run --filter",
		"base": "bun run --filter '*'",
		"dev:all": "bun run --filter './packages/apps/*/**' --parallel dev",
		"typecheck": "bun run --filter '*' typecheck",
		"docker:up": "docker compose up -d",
		"docker:down": "docker compose down",
		"watch:libs": "bun run --filter './packages/libs/**' --parallel dev",
		"prepare": "husky || true"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.8.3",
		"concurrently": "^9.0.1",
		"husky": "^9.0.11",
		"typescript": "catalog:"
	}
}
